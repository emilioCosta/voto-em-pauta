          "url": "https://QUEROAPOIAR.COM.BR/LUIZIANNELINS",
          "title": "Vaquinha Eleitoral da Luizianne 2026 | QueroApoiar",
          "sha256": "25856d7e70d8c954e2f108e48a7e0c404df77bcd17d3ca8936f16e298bf6cd86",
          "kind": "official-candidate-site",
