      ],
      "sources": [
        {
          "url": "http://www.reinaldosenador.com.br/",
          "title": "Senador Reinaldo Azambuja",
          "sha256": "ccb3095ce481fe2b374c2a8d1dbab44c89a0fd6757aa87860ef894ef4d5ead32",
          "kind": "official-candidate-site",
          "collected_at": "2026-10-03T19:36:04+00:00"
        },
        {
          "url": "http://www.reinaldosenador.com.br/noticias/campanha-elenca-222-motivos-para-voltar-no-reinaldo-neste-domingo",
          "title": "Campanha elenca 222 motivos para voltar no Reinaldo neste domingo | Senador Reinaldo Azambuja",
          "sha256": "74837a2f865362e4983375a3edd023f12c2a9af50a69d4398d262d696992f618",
          "kind": "official-candidate-site",
          "collected_at": "2026-10-03T19:36:06+00:00"
        }
      ],
      "statements": [
        {
          "text": "Defender uma reforma do pacto federativo, reduzindo a concentração de recursos em Brasília e garantindo mais autonomia para os municípios.",
          "section_title": "Mais recursos para os municípios",
          "topics": [],
          "source_url": "http://www.reinaldosenador.com.br/",
          "source_title": "Senador Reinaldo Azambuja",
          "source_sha256": "ccb3095ce481fe2b374c2a8d1dbab44c89a0fd6757aa87860ef894ef4d5ead32",
          "collected_at": "2026-10-03T19:36:04+00:00"
        },
        {
          "text": "Articular investimentos federais para melhorar os acessos rodoviários, fortalecer a infraestrutura aeroportuária, ampliar a qualificação profissional e apoiar o turismo sustentável.",
          "section_title": "Turismo com infraestrutura",
          "topics": [
            "infrastructure-mobility"
          ],
          "source_url": "http://www.reinaldosenador.com.br/",
          "source_title": "Senador Reinaldo Azambuja",
          "source_sha256": "ccb3095ce481fe2b374c2a8d1dbab44c89a0fd6757aa87860ef894ef4d5ead32",
          "collected_at": "2026-10-03T19:36:04+00:00"
        },
        {
          "text": "Defender um novo modelo de financiamento federal, com planejamento e recursos suficientes para evitar obras paralisadas e garantir que os investimentos sejam concluídos.",
          "section_title": "Obras que começam e terminam",
          "topics": [],
          "source_url": "http://www.reinaldosenador.com.br/",
          "source_title": "Senador Reinaldo Azambuja",
          "source_sha256": "ccb3095ce481fe2b374c2a8d1dbab44c89a0fd6757aa87860ef894ef4d5ead32",
          "collected_at": "2026-10-03T19:36:04+00:00"
        },
        {
          "text": "Vai defender a importância da agropecuária e da agroindústria para a economia e geração de empregos;",
          "section_title": "Mais fotos",
          "topics": [
            "economy-jobs"
          ],
          "source_url": "http://www.reinaldosenador.com.br/noticias/campanha-elenca-222-motivos-para-voltar-no-reinaldo-neste-domingo",
          "source_title": "Campanha elenca 222 motivos para voltar no Reinaldo neste domingo | Senador Reinaldo Azambuja",
          "source_sha256": "74837a2f865362e4983375a3edd023f12c2a9af50a69d4398d262d696992f618",
          "collected_at": "2026-10-03T19:36:06+00:00"
        },
        {
          "text": "Destinou mais de R$ 10 milhões em insumos para apoiar a produção indígena, incluindo sementes de milho, feijão, abóbora e melancia, calcário, óleo diesel e manutenção de tratores;",
          "section_title": "Mais fotos",
          "topics": [],
          "source_url": "http://www.reinaldosenador.com.br/noticias/campanha-elenca-222-motivos-para-voltar-no-reinaldo-neste-domingo",
          "source_title": "Campanha elenca 222 motivos para voltar no Reinaldo neste domingo | Senador Reinaldo Azambuja",
          "source_sha256": "74837a2f865362e4983375a3edd023f12c2a9af50a69d4398d262d696992f618",
          "collected_at": "2026-10-03T19:36:06+00:00"
        }
      ],
      "status": "proposals-found"
